      "profile": {
        "rows": 64000,
        "columns": 65536,
        "histogram": "8:9,88:1",
        "seed": 17
      }
    },
    {
      "name": "tail-2-percent",
      "category": "long infrequent tail",
      "profile": {
        "rows": 64000,
        "columns": 65536,
        "histogram": "8:98,408:2",
        "seed": 17
      }
    },
    {
      "name": "tail-1-percent",
      "category": "extreme rare tail",
      "profile": {
        "rows": 64000,
        "columns": 65536,
        "histogram": "8:99,808:1",
        "seed": 17
      }
