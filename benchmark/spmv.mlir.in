func.func @spmv(
    %rowOffsets: memref<?xi32>,
    %columnIndices: memref<?xi32>,
    %values: memref<?xf32>,
    %vector: memref<?xf32>,
    %output: memref<?xf32>) {
  sparsewave.spmv %rowOffsets, %columnIndices, %values, %vector, %output
      : memref<?xi32>, memref<?xi32>, memref<?xf32>, memref<?xf32>,
        memref<?xf32>
  return
}

func.func @main() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %cRows = arith.constant @ROWS@ : index
  %cRowsPlusOne = arith.constant @ROWS_PLUS_ONE@ : index
  %cColumns = arith.constant @COLUMNS@ : index
  %cNnz = arith.constant @NNZ@ : index
  %cDispatches = arith.constant @DISPATCHES@ : index
  %c0I64 = arith.constant 0 : i64
  %c1I64 = arith.constant 1 : i64
  %c1F32 = arith.constant 1.0 : f32

  %hostRowOffsets = memref.alloc(%cRowsPlusOne) : memref<?xi32>
  %hostColumnIndices = memref.alloc(%cNnz) : memref<?xi32>
  %hostValues = memref.alloc(%cNnz) : memref<?xf32>
  %hostVector = memref.alloc(%cColumns) : memref<?xf32>
  %hostOutput = memref.alloc(%cRows) : memref<?xf32>
  %errorOutput = memref.alloc() : memref<1xi64>

  %c0I32 = arith.constant 0 : i32
  memref.store %c0I32, %hostRowOffsets[%c0] : memref<?xi32>
  scf.for %row = %c0 to %cRows step %c1
      iter_args(%offset = %c0) -> index {
    @ROW_LENGTH@
    %nextOffset = arith.addi %offset, %rowLength : index
    %nextOffsetI32 = arith.index_cast %nextOffset : index to i32
    %nextRow = arith.addi %row, %c1 : index
    memref.store %nextOffsetI32, %hostRowOffsets[%nextRow] : memref<?xi32>
    scf.yield %nextOffset : index
  }
  scf.for %position = %c0 to %cNnz step %c1 {
    %column = arith.remui %position, %cColumns : index
    %columnI32 = arith.index_cast %column : index to i32
    memref.store %columnI32, %hostColumnIndices[%position] : memref<?xi32>
    memref.store %c1F32, %hostValues[%position] : memref<?xf32>
  }
  scf.for %column = %c0 to %cColumns step %c1 {
    memref.store %c1F32, %hostVector[%column] : memref<?xf32>
  }

  %start = gpu.wait async
  %deviceRowOffsets, %alloc0 =
      gpu.alloc async [%start] (%cRowsPlusOne) : memref<?xi32>
  %deviceColumnIndices, %alloc1 =
      gpu.alloc async [%alloc0] (%cNnz) : memref<?xi32>
  %deviceValues, %alloc2 =
      gpu.alloc async [%alloc1] (%cNnz) : memref<?xf32>
  %deviceVector, %alloc3 =
      gpu.alloc async [%alloc2] (%cColumns) : memref<?xf32>
  %deviceOutput, %alloc4 =
      gpu.alloc async [%alloc3] (%cRows) : memref<?xf32>

  %copy0 = gpu.memcpy async [%alloc4] %deviceRowOffsets, %hostRowOffsets
      : memref<?xi32>, memref<?xi32>
  %copy1 =
      gpu.memcpy async [%copy0] %deviceColumnIndices, %hostColumnIndices
      : memref<?xi32>, memref<?xi32>
  %copy2 = gpu.memcpy async [%copy1] %deviceValues, %hostValues
      : memref<?xf32>, memref<?xf32>
  %copy3 = gpu.memcpy async [%copy2] %deviceVector, %hostVector
      : memref<?xf32>, memref<?xf32>
  gpu.wait [%copy3]

  scf.for %iteration = %c0 to %cDispatches step %c1 {
    func.call @spmv(%deviceRowOffsets, %deviceColumnIndices, %deviceValues,
                    %deviceVector, %deviceOutput)
        : (memref<?xi32>, memref<?xi32>, memref<?xf32>, memref<?xf32>,
           memref<?xf32>) -> ()
  }

  %outputStart = gpu.wait async
  %outputCopy = gpu.memcpy async [%outputStart] %hostOutput, %deviceOutput
      : memref<?xf32>, memref<?xf32>
  gpu.wait [%outputCopy]

  %errors = scf.for %row = %c0 to %cRows step %c1
      iter_args(%count = %c0I64) -> i64 {
    @ROW_LENGTH@
    %rowLengthI64 = arith.index_cast %rowLength : index to i64
    %expected = arith.uitofp %rowLengthI64 : i64 to f32
    %actual = memref.load %hostOutput[%row] : memref<?xf32>
    %mismatch = arith.cmpf une, %actual, %expected : f32
    %increment = arith.select %mismatch, %c1I64, %c0I64 : i64
    %next = arith.addi %count, %increment : i64
    scf.yield %next : i64
  }
  memref.store %errors, %errorOutput[%c0] : memref<1xi64>
  %errorOutputUnranked =
      memref.cast %errorOutput : memref<1xi64> to memref<*xi64>
  func.call @printMemrefI64(%errorOutputUnranked) : (memref<*xi64>) -> ()

  gpu.dealloc %deviceRowOffsets : memref<?xi32>
  gpu.dealloc %deviceColumnIndices : memref<?xi32>
  gpu.dealloc %deviceValues : memref<?xf32>
  gpu.dealloc %deviceVector : memref<?xf32>
  gpu.dealloc %deviceOutput : memref<?xf32>
  memref.dealloc %hostRowOffsets : memref<?xi32>
  memref.dealloc %hostColumnIndices : memref<?xi32>
  memref.dealloc %hostValues : memref<?xf32>
  memref.dealloc %hostVector : memref<?xf32>
  memref.dealloc %hostOutput : memref<?xf32>
  memref.dealloc %errorOutput : memref<1xi64>
  return
}

func.func private @printMemrefI64(memref<*xi64>)
