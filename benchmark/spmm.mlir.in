func.func @spmm(
    %rowOffsets: memref<?xi32>,
    %columnIndices: memref<?xi32>,
    %values: memref<?xf32>,
    %rhs: memref<?x?xf32>,
    %output: memref<?x?xf32>) {
  sparsewave.spmm %rowOffsets, %columnIndices, %values, %rhs, %output
      : memref<?xi32>, memref<?xi32>, memref<?xf32>,
        memref<?x?xf32>, memref<?x?xf32>
  return
}

func.func @main() {
  %c0 = arith.constant 0 : index
  %c1 = arith.constant 1 : index
  %cRows = arith.constant @ROWS@ : index
  %cRowsPlusOne = arith.constant @ROWS_PLUS_ONE@ : index
  %cInputColumns = arith.constant @INPUT_COLUMNS@ : index
  %cRhsColumns = arith.constant @RHS_COLUMNS@ : index
  %cNnz = arith.constant @NNZ@ : index
  %cDispatches = arith.constant @DISPATCHES@ : index

  %hostRowOffsets = memref.alloc(%cRowsPlusOne) : memref<?xi32>
  %hostColumnIndices = memref.alloc(%cNnz) : memref<?xi32>
  %hostValues = memref.alloc(%cNnz) : memref<?xf32>
  %hostRhs =
      memref.alloc(%cInputColumns, %cRhsColumns) : memref<?x?xf32>
  %hostOutput = memref.alloc(%cRows, %cRhsColumns) : memref<?x?xf32>
  %hostExpected = memref.alloc(%cRows, %cRhsColumns) : memref<?x?xf64>
  %hostTolerances = memref.alloc(%cRows, %cRhsColumns) : memref<?x?xf64>
  %errorOutput = memref.alloc() : memref<1xi64>

  func.call @loadSpMMBenchmarkInputs(
      %hostRowOffsets, %hostColumnIndices, %hostValues,
      %hostRhs, %hostExpected, %hostTolerances)
      : (memref<?xi32>, memref<?xi32>, memref<?xf32>,
         memref<?x?xf32>, memref<?x?xf64>, memref<?x?xf64>) -> ()

  %start = gpu.wait async
  %deviceRowOffsets, %alloc0 =
      gpu.alloc async [%start] (%cRowsPlusOne) : memref<?xi32>
  %deviceColumnIndices, %alloc1 =
      gpu.alloc async [%alloc0] (%cNnz) : memref<?xi32>
  %deviceValues, %alloc2 =
      gpu.alloc async [%alloc1] (%cNnz) : memref<?xf32>
  %deviceRhs, %alloc3 =
      gpu.alloc async [%alloc2] (%cInputColumns, %cRhsColumns)
      : memref<?x?xf32>
  %deviceOutput, %alloc4 =
      gpu.alloc async [%alloc3] (%cRows, %cRhsColumns) : memref<?x?xf32>

  %copy0 = gpu.memcpy async [%alloc4] %deviceRowOffsets, %hostRowOffsets
      : memref<?xi32>, memref<?xi32>
  %copy1 =
      gpu.memcpy async [%copy0] %deviceColumnIndices, %hostColumnIndices
      : memref<?xi32>, memref<?xi32>
  %copy2 = gpu.memcpy async [%copy1] %deviceValues, %hostValues
      : memref<?xf32>, memref<?xf32>
  %copy3 = gpu.memcpy async [%copy2] %deviceRhs, %hostRhs
      : memref<?x?xf32>, memref<?x?xf32>
  gpu.wait [%copy3]

  scf.for %iteration = %c0 to %cDispatches step %c1 {
    func.call @spmm(%deviceRowOffsets, %deviceColumnIndices, %deviceValues,
                    %deviceRhs, %deviceOutput)
        : (memref<?xi32>, memref<?xi32>, memref<?xf32>,
           memref<?x?xf32>, memref<?x?xf32>) -> ()
  }

  %outputStart = gpu.wait async
  %outputCopy = gpu.memcpy async [%outputStart] %hostOutput, %deviceOutput
      : memref<?x?xf32>, memref<?x?xf32>
  gpu.wait [%outputCopy]

  %errors = func.call @verifySpMMBenchmarkOutput(
      %hostOutput, %hostExpected, %hostTolerances)
      : (memref<?x?xf32>, memref<?x?xf64>, memref<?x?xf64>) -> i64
  memref.store %errors, %errorOutput[%c0] : memref<1xi64>
  %errorOutputUnranked =
      memref.cast %errorOutput : memref<1xi64> to memref<*xi64>
  func.call @printMemrefI64(%errorOutputUnranked) : (memref<*xi64>) -> ()

  gpu.dealloc %deviceRowOffsets : memref<?xi32>
  gpu.dealloc %deviceColumnIndices : memref<?xi32>
  gpu.dealloc %deviceValues : memref<?xf32>
  gpu.dealloc %deviceRhs : memref<?x?xf32>
  gpu.dealloc %deviceOutput : memref<?x?xf32>
  memref.dealloc %hostRowOffsets : memref<?xi32>
  memref.dealloc %hostColumnIndices : memref<?xi32>
  memref.dealloc %hostValues : memref<?xf32>
  memref.dealloc %hostRhs : memref<?x?xf32>
  memref.dealloc %hostOutput : memref<?x?xf32>
  memref.dealloc %hostExpected : memref<?x?xf64>
  memref.dealloc %hostTolerances : memref<?x?xf64>
  memref.dealloc %errorOutput : memref<1xi64>
  return
}

func.func private @printMemrefI64(memref<*xi64>)
func.func private @loadSpMMBenchmarkInputs(
    memref<?xi32>, memref<?xi32>, memref<?xf32>,
    memref<?x?xf32>, memref<?x?xf64>, memref<?x?xf64>)
    attributes {llvm.emit_c_interface}

func.func private @verifySpMMBenchmarkOutput(
    memref<?x?xf32>, memref<?x?xf64>, memref<?x?xf64>) -> i64
    attributes {llvm.emit_c_interface}
